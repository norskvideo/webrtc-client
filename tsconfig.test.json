{
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.mts"],
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true
  }
}
